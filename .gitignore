.DS_Store

# Large raw datasets (exceed GitHub 100MB limit), kept locally only
pipeline/purpleair_full_dataset.csv
pipeline/purpleair_training_ready.csv
p2_processed_v2.xls

# API cache from data pull scripts
pipeline/data_pull_cache/

# Standalone landing site build artifacts
website/node_modules/
website/dist/

# The old repo-root LaTeX paper folders: kept locally only, not tracked.
# Root-anchored on purpose: a bare "paper/" matches a directory of that name at
# ANY depth, which silently swallowed xai/XAI UTRC/paper/ and meant new files
# added there were never committed.
/paper/
/paper_hs/

logs/

# Runtime state (regenerated by the server)
backend/visit_count.json
backend/visits.sqlite

# Scratch notebooks
*.ipynb

# Per-model LOSO out-of-fold predictions (12MB derived artifact; regenerated by
# pipeline/03_train_enhanced.py, used only by pipeline/eval_calibration.py).
# All headline numbers are in models/metrics.json.
models/loso_oof.npz
# Per-shard LOSO checkpoints from the parallel retrain wrappers
# ("8-8-26 huge retrain/scripts/loso_shard.py"); merged into the files above.
models/loso_shard_*.joblib
models/loso_shard_*.joblib.tmp
.vercel

# Secrets. backend/.env holds the PurpleAir READ key for local runs; it is
# listed explicitly so the rule survives any edit to the .env* pattern.
.env*
backend/.env

# Training / test byproducts and the local venv the README suggests
catboost_info/
.pytest_cache/
.venv/

# scripts/fetch_prediction_log.py output (about 1.7M tract rows a month)
prediction_log/
